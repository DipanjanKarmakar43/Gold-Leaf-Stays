<% if (success && success.length > 0) { %>
    <div class="flash-success">
        <div class="flash-message">
            <i class="fa-solid fa-circle-check"></i>
            <span><%= success[0] %></span>
        </div>
    </div>
<% } %>

<% if (error && error.length > 0) { %>
    <div class="flash-error">
        <div class="flash-message">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span><%= error[0] %></span>
        </div>
    </div>
<% } %>